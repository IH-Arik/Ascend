APP_NAME=Ascend Backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8010
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Local Mongo example:
MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas example:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=Ascend
MONGODB_DB_NAME=ascend_db
MONGODB_TLS=false
DB_REQUIRED=false
REDIS_URL=
STORAGE_BUCKET=
STORAGE_REGION=
LOGIN_EMAIL=
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SUPPORT_EMAIL=
SUPPORT_PHONE=
HELP_CENTER_URL=
TERMS_OF_USE_URL=
PRIVACY_POLICY_URL=
POLICY_VERSION=ascend-ia-01@1.4.0
OPSEC_NOTICE_TEXT=Protect sensitive readiness, mission, and personal information. Do not share OPSEC or CUI through unauthorized channels.
AI_PROVIDER_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
