APP_NAME=Ascend Backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8010
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=change-me
# The ONLY Superadmin bootstrap path: if set, a registration using this
# exact email gets the DWS Superadmin role instead of the default Airman,
# regardless of the role requested in the payload. Leave blank until you're
# ready to create the first Superadmin, then set it, register that one
# account, and consider clearing it again afterward.
SUPERADMIN_EMAIL=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Local Mongo example:
MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas example:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=Ascend
MONGODB_DB_NAME=ascend_db
MONGODB_TLS=false
DB_REQUIRED=false
REDIS_URL=
STORAGE_BUCKET=
STORAGE_REGION=
LOGIN_EMAIL=
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SUPPORT_EMAIL=
SUPPORT_PHONE=
HELP_CENTER_URL=
TERMS_OF_USE_URL=
PRIVACY_POLICY_URL=
POLICY_VERSION=ascend-ia-01@1.4.0
OPSEC_NOTICE_TEXT=Protect sensitive readiness, mission, and personal information. Do not share OPSEC or CUI through unauthorized channels.
AI_PROVIDER_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Real, live email delivery (app/services/email_service.py). Resend's
# shared test sender works with no domain setup; switch to a verified
# custom domain address once the client provides one.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
# Not yet provisioned - see docs/CREDENTIALS_NEEDED.md. SMS/push send
# real "not_configured" responses (not fabricated success) until these are
# set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=
